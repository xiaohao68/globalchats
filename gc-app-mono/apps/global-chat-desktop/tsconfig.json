{
  "extends": "@gc/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@gc/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@gc/lib/*": [
        "../../packages/ui/src/lib/*"
      ]
    }
  },
  "include": [
    "src",
    "src-preload",
    "vite.config.ts",
    "vite.preload.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src-tauri",
    "dist",
    "build",
    "release"
  ]
}
