{
  "name": "gc",
  "version": "26.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter gc-app dev",
    "build": "pnpm --filter gc-app build",
    "start": "pnpm --filter gc-app start",
    "lint": "pnpm --filter gc-app lint",
    "typecheck": "pnpm --filter gc-app typecheck",
